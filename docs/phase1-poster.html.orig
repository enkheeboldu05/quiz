<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI-Powered Lecture-Based Quiz Platform — Phase 1 Poster</title>
  <style>
    * { box-sizing: border-box; }

    @page { size: A4 portrait; margin: 0; }

    body {
      margin: 0;
      background: #ddd;
      color: #111;
      font-family: Arial, Helvetica, sans-serif;
    }

    .poster {
      width: 210mm;
      height: 297mm;
      margin: 0 auto;
      padding: 15mm 17mm;
      background: #fff;
    }

    .template-label {
      margin: 0 0 9mm;
      font-size: 8pt;
    }

    h1 {
      max-width: 175mm;
      margin: 0 0 3mm;
      font-size: 23pt;
      line-height: 1;
    }

    .authors {
      margin: 0 0 8mm;
      font-size: 9pt;
    }

    h2 {
      margin: 0 0 4mm;
      font-size: 10pt;
    }

    p, li {
      font-size: 9pt;
      line-height: 1.45;
    }

    .layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9mm;
    }

    .column {
      display: grid;
      align-content: start;
      gap: 7mm;
    }

    .description p { margin: 0; }

    .screenshots {
      display: grid;
      gap: 3mm;
    }

    .screenshot {
      height: 32mm;
      margin: 0;
      overflow: hidden;
      border: 1px solid #999;
      background: #fff;
    }

    .screenshot img {
      display: block;
      width: 100%;
      height: auto;
      transform: translateY(-6mm);
    }

    .features {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .features li { margin-bottom: 4mm; }

    .features li::before { content: "+ "; }

    .box {
      padding: 5mm;
      border: 1px solid #777;
    }

    .architecture { min-height: 94mm; }

    .architecture-flow {
      display: grid;
      gap: 4mm;
      margin-top: 8mm;
      text-align: center;
    }

    .node {
      padding: 4mm;
      border: 1px solid #777;
      font-size: 8pt;
      line-height: 1.4;
    }

    .role {
      display: block;
      margin-bottom: 1mm;
      font-size: 6pt;
      font-weight: bold;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .arrow { font-size: 13pt; }

    .service-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4mm;
    }

    .tools { min-height: 82mm; }

    .tools p {
      margin: 0 0 3mm;
      font-size: 8.5pt;
    }

    .tools h2:not(:first-child) { margin-top: 8mm; }

    @media print {
      body { background: none; }
      .poster { margin: 0; }
    }
  </style>
</head>
<body>
  <main class="poster">
    <p class="template-label">Phase 1 Project</p>
    <h1>AI-Powered Lecture-Based Quiz Platform</h1>
    <p class="authors">배성빈 · 앤코벌드</p>

    <div class="layout">
      <div class="column">
        <section class="description">
          <h2>Description (one sentence):</h2>
          <p>A web application that generates practice quizzes from lecture PDF files.</p>
        </section>

        <section>
          <h2>Screenshots:</h2>
          <div class="screenshots">
            <figure class="screenshot"><img src="Screenshot 2026-09-30 203216.png" alt="Login page"></figure>
            <figure class="screenshot"><img src="Screenshot 2026-09-30 203348.png" alt="Dashboard"></figure>
            <figure class="screenshot"><img src="Screenshot 2026-09-30 203427.png" alt="Questions"></figure>
          </div>
        </section>

        <section>
          <h2>Key Features:</h2>
          <ul class="features">
            <li>User sign-up, login, and private quiz data.</li>
            <li>Generate questions from a text-based PDF.</li>
            <li>Choose question format and difficulty.</li>
            <li>Take quizzes and view scores and explanations.</li>
            <li>Save, search, organize, rename, and delete quizzes.</li>
          </ul>
        </section>
      </div>

      <div class="column">
        <section class="box architecture">
          <h2>Architecture:</h2>
          <div class="architecture-flow">
            <div class="node"><span class="role">Interface</span>Browser<br>EJS · HTML · CSS · JavaScript</div>
            <div class="arrow">↓</div>
            <div class="node"><span class="role">Processing</span>Node.js + Express<br>Authentication · Routes · PDF extraction</div>
            <div class="arrow">↓</div>
            <div class="service-row">
              <div class="node"><span class="role">Storage</span>SQLite<br>Users · Quizzes · Attempts</div>
              <div class="node"><span class="role">Generation</span>Hugging Face<br>Question generation</div>
            </div>
          </div>
        </section>

        <section class="box tools">
          <h2>Tools:</h2>
          <p>Node.js</p>
          <p>Express</p>
          <p>EJS</p>
          <p>SQLite</p>
          <p>Hugging Face</p>
          <p>Codex</p>
          <p>ChatGPT — GPT-5.6 Sol</p>

          <h2>Platform:</h2>
          <p>Windows 11</p>
          <p>Ubuntu on WSL</p>
          <p>Local web server</p>
        </section>
      </div>
    </div>

  </main>
</body>
</html>
